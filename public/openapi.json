                            "plan_limit_reached"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "data_preserved": {
                          "type": "boolean"
                        },
                        "retry_safe": {
                          "type": "boolean"
                        },
                        "next_action": {
                          "type": "string"
                        },
                        "request_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "data_preserved",
                        "retry_safe",
                        "next_action",
                        "request_id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "temporarily_unavailable: The service is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
