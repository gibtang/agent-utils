                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "code"
                ]
              }
            }
          }
        },
        "parameters": []
      }
    },
    "/v1/connections/status": {
      "get": {
        "operationId": "connection_status",
        "summary": "Return the status of the calling connection.",
        "description": "Returns the connection record, the paired agent name, the account plan and the granted capabilities. Requires a valid connection credential (Bearer au_conn_…).",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "agentName": {
                      "type": "string"
                    },
                    "connection": {
                      "type": "object",
                      "properties": {
                        "connectionId": {
                          "type": "string",
                          "pattern": "^conn_"
                        },
                        "agentId": {
                          "type": "string"
                        },
                        "accountId": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "runtime": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "displayPrefix": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": [
                        "connectionId",
                        "agentId",
                        "accountId",
                        "status",
                        "runtime",
                        "displayPrefix",
                        "createdAt"
                      ],
                      "additionalProperties": false
                    },
                    "plan": {
                      "type": "string"
                    },
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "agentName",
                    "connection",
                    "plan",
                    "capabilities"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "authentication_required: Authentication is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
