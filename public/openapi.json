                        "message": {
                          "type": "string"
                        },
                        "data_preserved": {
                          "type": "boolean"
                        },
                        "retry_safe": {
                          "type": "boolean"
                        },
                        "next_action": {
                          "type": "string"
                        },
                        "request_id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "data_preserved",
                        "retry_safe",
                        "next_action",
                        "request_id"
                      ],
                      "additionalProperties": false
